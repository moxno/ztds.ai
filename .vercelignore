# Vercel Deployment Ignore Rules
# Strictly block internal business documents, intellectual property, agent memory, and test suites from static deployment

# Internal Agent & AI Config (root only)
/.agents
/.agent
/.github
/.cursor
/.ruff_cache
.env*

# Internal Business Documents, SOPs, Playbooks & Specs (SSOT Grounding - root only)
/docs
/DESIGN.md

# Internal Tests, Automation Scripts & CLI Source (root only)
/test
/scripts
!/scripts/vercel-ignore-build.js
/bin
/python
/skills
/stitch_export
/packages
/keys
/action.yml
/data/test-vectors.json

# Ignore all markdown files anywhere
*.md
