#!/bin/sh
# =============================================================================
# ZTDS.ai Unified IP & Secret Leak Prevention — Git Pre-Commit Hook
# =============================================================================
# Delegates to the single-source-of-truth Node.js gate (`scripts/ip-leak-gate.js`),
# shared identically with `npm test` and `.github/workflows/ip-guard.yml`.
# Eliminates bash `pipefail` + `grep -q` SIGPIPE (exit 141) fail-open bugs.
# =============================================================================

set -eu

REPO_ROOT="$(git rev-parse --show-toplevel)"
exec node "${REPO_ROOT}/scripts/ip-leak-gate.js" --staged
