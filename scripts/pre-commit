#!/bin/bash
# =============================================================================
# ZTDS.ai IP Leak Prevention — Git Pre-Commit Hook
# =============================================================================
# Blocks commits containing:
#   - Private keys, secrets, API tokens
#   - PrivacyScrubber commercial engine code (.js from /src/core/)
#   - Agent operational strategy (.agents/)
#   - Internal briefings and negotiations
#   - NotebookLM IDs, Paddle/Stripe keys, customer PII
#
# Install: cp scripts/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
# Bypass (emergency only): git commit --no-verify
# =============================================================================

set -euo pipefail

RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color
BOLD='\033[1m'

BLOCKED=0

echo ""
echo "${BOLD}[ZTDS IP Guard] Scanning staged files for sensitive content...${NC}"
echo ""

# --- 1. Blocked paths (should never be committed) ---
BLOCKED_PATHS=(
  ".agents/"
  ".agent/"
  "keys/ztds_license_private"
  "keys/ztds_ed25519_private"
  ".env.local"
  ".env.production"
  "src/core/pii-engine-core"
  "src/core/tree-scrubber"
  "src/core/token-processor"
  "src/core/quota-engine"
  "src/core/worker-manager"
  "src/core/dom.js"
  "src/core/state.js"
  "src/modules/"
)

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null || true)

for file in $STAGED_FILES; do
  for blocked in "${BLOCKED_PATHS[@]}"; do
    if [[ "$file" == *"$blocked"* ]]; then
      echo "${RED}BLOCKED${NC}: ${file}"
      echo "         Reason: matches protected path pattern '${blocked}'"
      BLOCKED=1
    fi
  done
done

# --- 2. Content patterns (secrets, keys, tokens) ---
# Files that reference patterns by name (the guards themselves) are whitelisted
SELF_WHITELIST="scripts/pre-commit|.github/workflows/ip-guard.yml|.gitignore|.agents/rules/ip-leak-prevention.md"

SECRET_PATTERNS=(
  'PRIVATE KEY'
  'sk-[a-zA-Z0-9_-]{20,}'
  'sk_live_[a-zA-Z0-9]+'
  'sk_test_[a-zA-Z0-9]+'
  'ghp_[a-zA-Z0-9]{36}'
  'AIza[0-9A-Za-z_-]{35}'
  'paddlesecret_[a-zA-Z0-9]+'
  'paddle_live_[a-zA-Z0-9]+'
  'paddle_test_[a-zA-Z0-9]+'
  'SERPER_API_KEY\s*=\s*["\x27][^"\x27]+'
  'SUPABASE_SERVICE_ROLE_KEY\s*=\s*["\x27][^"\x27]+'
  'OPENAI_API_KEY\s*=\s*["\x27][^"\x27]+'
  'ANTHROPIC_API_KEY\s*=\s*["\x27][^"\x27]+'
  'PADDLE_API_KEY\s*=\s*["\x27][^"\x27]+'
  'STRIPE_SECRET\s*=\s*["\x27][^"\x27]+'
  'RESEND_API_KEY\s*=\s*["\x27][^"\x27]+'
)

for file in $STAGED_FILES; do
  # Skip whitelisted guard files (they reference patterns by name)
  if echo "$file" | grep -qE "$SELF_WHITELIST"; then
    continue
  fi
  # Skip example template files
  if [[ "$file" == *".example"* ]]; then
    continue
  fi
  # Skip binary files
  if file "$file" 2>/dev/null | grep -q "binary"; then
    continue
  fi
  
  if [ ! -f "$file" ]; then
    continue
  fi

  for pattern in "${SECRET_PATTERNS[@]}"; do
    if git diff --cached -- "$file" | grep -E '^\+[^+]' | grep -qEi "$pattern" 2>/dev/null; then
      echo "${RED}BLOCKED${NC}: ${file}"
      echo "         Reason: contains secret pattern '${pattern}'"
      BLOCKED=1
      break
    fi
  done
done

# --- 3. Commercial engine IP patterns ---
IP_PATTERNS=(
  'pii-engine-core'
  'piiEngineCore'
  'tree-scrubber'
  'treeScrubber'
  'quota-engine'
  'quotaEngine'
  'worker-manager'
  'workerManager'
  'PROFILE_RULES\s*='
  'industryProfiles\s*='
  'HIPAA_PHI_PATTERNS'
  'IBAN_PATTERNS'
  'FRE_502_PATTERNS'
  'CLOUD_SECRET_PATTERNS'
  'NotebookLM.*Notebook.*ID'
  'ztds_license_private'
  'ztds_ed25519_private'
)

for file in $STAGED_FILES; do
  # Skip whitelisted guard files
  if echo "$file" | grep -qE "$SELF_WHITELIST"; then
    continue
  fi
  if [ ! -f "$file" ]; then
    continue
  fi

  for pattern in "${IP_PATTERNS[@]}"; do
    if git diff --cached -- "$file" | grep -E '^\+[^+]' | grep -qEi "$pattern" 2>/dev/null; then
      echo "${RED}BLOCKED${NC}: ${file}"
      echo "         Reason: contains commercial IP pattern '${pattern}'"
      BLOCKED=1
      break
    fi
  done
done

# --- 4. Large file check (>500KB -- potential data dump) ---
for file in $STAGED_FILES; do
  if [ -f "$file" ]; then
    FILE_SIZE=$(wc -c < "$file" 2>/dev/null | tr -d ' ')
    if [ "$FILE_SIZE" -gt 512000 ] 2>/dev/null; then
      EXT="${file##*.}"
      # Allow known large files (SVG badges, HTML pages, CSS)
      if [[ "$EXT" != "svg" && "$EXT" != "html" && "$EXT" != "css" && "$EXT" != "json" ]]; then
        echo "${YELLOW}WARNING${NC}: ${file} (${FILE_SIZE} bytes)"
        echo "         Large file detected. Verify it contains no sensitive data."
      fi
    fi
  fi
done

# --- 5. Verdict ---
echo ""
if [ $BLOCKED -eq 1 ]; then
  echo "${RED}${BOLD}COMMIT BLOCKED${NC}: Sensitive content detected in staged files."
  echo ""
  echo "If this is a false positive, use: ${YELLOW}git commit --no-verify${NC}"
  echo "Otherwise, unstage the files: ${YELLOW}git reset HEAD <file>${NC}"
  echo ""
  exit 1
else
  echo "${BOLD}[ZTDS IP Guard] All clear. No sensitive content detected.${NC}"
  echo ""
fi
