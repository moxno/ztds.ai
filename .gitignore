# =============================================================================
# ZTDS.ai — Comprehensive .gitignore
# Protects commercial IP, operational strategy, and secrets from public exposure
# =============================================================================

# Agent Configuration (operational strategy, internal skills, license workflows)
# CRITICAL: Contains two-brand strategy, Ed25519 license minting, NotebookLM IDs
.agents/
.agent/

# Private Signing Keys & Certificates
keys/ztds_license_private.pem
keys/ztds_ed25519_private.pem
*.private.pem
*.key.pem
*.p12
*.pfx

# Environment Variables & Secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local

# PrivacyScrubber Commercial Engine (should NEVER exist in this repo)
# If any of these appear, something went wrong — pre-commit hook will block
src/core/
src/modules/

# Internal Executive Briefings & Negotiations
docs/*Briefing*.md
docs/*_HE.md
docs/*_CONFIDENTIAL*
docs/*_INTERNAL*

# Dependencies
node_modules/
.pnp
.pnp.js

# OS
.DS_Store
Thumbs.db
Desktop.ini

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# Build & Deploy Artifacts
.vercel/
stitch_export/

# Archives (except whitelisted)
*.zip
!public/docs/*.zip
!docs/enterprise/*.zip

# Temporary & Scratch
tmp/
temp/
scratch/
*.tmp
*.bak
*.swp
*~
