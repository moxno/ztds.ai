{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": true,
  "git": {
    "deploymentEnabled": {
      "main": true
    },
    "ignoreCommand": "node scripts/vercel-ignore-build.js"
  },
  "rewrites": [
    {
      "source": "/badge/seal-verified.svg",
      "destination": "/public/badge/seal-verified.svg"
    },
    {
      "source": "/badge/seal-sovereign.svg",
      "destination": "/public/badge/seal-sovereign.svg"
    },
    {
      "source": "/badge/seal-dpa.svg",
      "destination": "/public/badge/seal-dpa.svg"
    },
    {
      "source": "/badge/:slug.svg",
      "destination": "/api/badge/?slug=:slug"
    },
    {
      "source": "/badge/:slug",
      "destination": "/api/badge/?slug=:slug"
    },
    {
      "source": "/llms.txt",
      "destination": "/public/llms.txt"
    },
    {
      "source": "/llms-full.txt",
      "destination": "/public/llms-full.txt"
    },
    {
      "source": "/plugin.json",
      "destination": "/public/plugin.json"
    },
    {
      "source": "/mcp_config.json",
      "destination": "/public/mcp_config.json"
    },
    {
      "source": "/favicon.svg",
      "destination": "/public/favicon.svg"
    },
    {
      "source": "/.well-known/security.txt",
      "destination": "/public/.well-known/security.txt"
    },
    {
      "source": "/.well-known/mcp.json",
      "destination": "/public/.well-known/mcp.json"
    },
    {
      "source": "/.well-known/agent.json",
      "destination": "/public/.well-known/agent.json"
    },
    {
      "source": "/.well-known/ai-plugin.json",
      "destination": "/public/.well-known/ai-plugin.json"
    },
    {
      "source": "/.well-known/mcp/server-card.json",
      "destination": "/public/.well-known/mcp/server-card.json"
    },
    {
      "source": "/server-card.json",
      "destination": "/public/.well-known/mcp/server-card.json"
    },
    {
      "source": "/docs/legal/order-form/",
      "destination": "/public/docs/legal/order-form/"
    },
    {
      "source": "/docs/:path*",
      "destination": "/public/docs/:path*"
    },
    {
      "source": "/schemas/:path*",
      "destination": "/public/schemas/:path*"
    },
    {
      "source": "/robots.txt",
      "destination": "/public/robots.txt"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/public/sitemap.xml"
    },
    {
      "source": "/3e691e75a7af4e158e48ab001cab95ef.txt",
      "destination": "/public/3e691e75a7af4e158e48ab001cab95ef.txt"
    },
    {
      "source": "/:key([a-f0-9]{32}).txt",
      "destination": "/public/:key.txt"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.ztds.ai"
        }
      ],
      "destination": "https://ztds.ai/:path*",
      "permanent": true
    },
    {
      "source": "/registry/privacyscrubber",
      "destination": "/registry/#privacyscrubber",
      "permanent": false
    },
    {
      "source": "/registry/privacyscrubber/",
      "destination": "/registry/#privacyscrubber",
      "permanent": false
    },
    {
      "source": "/registry/privacyscrubber-web",
      "destination": "/registry/#privacyscrubber",
      "permanent": false
    },
    {
      "source": "/registry/privacyscrubber-web/",
      "destination": "/registry/#privacyscrubber",
      "permanent": false
    },
    {
      "source": "/registry/privacyscrubber-sdk",
      "destination": "/registry/#privacyscrubber-sdk",
      "permanent": false
    },
    {
      "source": "/registry/privacyscrubber-sdk/",
      "destination": "/registry/#privacyscrubber-sdk",
      "permanent": false
    },
    {
      "source": "/registry/privacyscrubber-mcp",
      "destination": "/registry/#privacyscrubber-mcp",
      "permanent": false
    },
    {
      "source": "/registry/privacyscrubber-mcp/",
      "destination": "/registry/#privacyscrubber-mcp",
      "permanent": false
    },
    {
      "source": "/(\\.agents|\\.agent|\\.github|\\.cursor|\\.ruff_cache|config|keys|test|scripts|bin|python|src|lib|skills)(/.*|$)",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/(package\\.json|action\\.yml|data/test-vectors\\.json)",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/(.*)\\.(md|sh|key|pem|example)$",
      "destination": "/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(styles\\.css|favicon\\.svg|plugin\\.json|mcp_config\\.json|server-card\\.json)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "public, max-age=3600, s-maxage=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type" },
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, proxy-revalidate" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/.well-known/security.txt",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/.well-known/(mcp\\.json|mcp/server-card\\.json|agent\\.json|ai-plugin\\.json)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Content-Type", "value": "application/json; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/badge/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "public, max-age=86400, s-maxage=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/(assets/img/.*|og-image\\.png)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "public, max-age=86400, s-maxage=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/assets/fonts/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/llms(.*).txt",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600, s-maxage=86400" }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/schemas/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Content-Type", "value": "application/schema+json; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self'; frame-src 'none'; font-src 'self' data:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains; preload" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()" },
        { "key": "Link", "value": "<https://ztds.ai/llms.txt>; rel=\"alternate\"; type=\"text/plain\"; title=\"ZTDS LLM Knowledge Base\", <https://ztds.ai/llms-full.txt>; rel=\"alternate\"; type=\"text/plain\"; title=\"ZTDS Full Normative LLM Compendium\"" }
      ]
    }
  ]
}
